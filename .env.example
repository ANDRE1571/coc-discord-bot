# Discord bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# Discord application/client ID (Discord Developer Portal -> General Information -> Application ID)
DISCORD_CLIENT_ID=

# Optional: Guild ID for instant (guild-scoped) slash command registration during development.
# Leave empty to register commands globally (can take up to 1 hour to propagate).
DISCORD_GUILD_ID=

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Clash of Clans API token (https://developer.clashofclans.com -> My Account -> Create Key).
# The key must be bound to the public IP address this bot runs from.
COC_API_KEY=

# Path to the local SQLite database file used for linked accounts, progress
# snapshots, and reminders. Defaults to ./data/bot.sqlite if unset.
DATABASE_PATH=

# How often (in milliseconds) the reminder scheduler checks for due
# reminders. Defaults to 30000 (30s) if unset.
REMINDER_CHECK_INTERVAL_MS=
